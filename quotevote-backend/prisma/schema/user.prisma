// User and authentication related models
// User model - Core user entity

model User {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  email             String        @unique
  username          String        @unique
  name              String?
  /// Legacy stores the bcrypt hash as `hash_password`; both servers share this field.
  password          String?       @map("hash_password")
  avatar            Json?
  bio               String?
  location          String?
  website           String?
  companyName       String?
  plan              String?       @default("personal")
  stripeCustomerId  String?
  tokens            Int           @default(0)
  wallet            String?       @map("_wallet")
  votesId           String?       @map("_votesId") @db.ObjectId
  favorited         Json?         @default("[]")
  status            Int?
  contributorBadge  Boolean       @default(false)
  accountStatus     AccountStatus @default(active)
  emailVerified     Boolean       @default(false)
  isAdmin           Boolean       @default(false) @map("admin")
  isModerator       Boolean       @default(false)
  botReports        Int           @default(0)
  lastBotReportDate DateTime?
  upvotes           Int           @default(0)
  downvotes         Int           @default(0)
  followingIds      String[]      @map("_followingId") @db.ObjectId
  followerIds       String[]      @map("_followersId") @db.ObjectId
  blockedUserIds    String[]      @db.ObjectId
  settings          Json?
  lastLogin         DateTime?
  joined            DateTime      @default(now())
  reputation        EmbeddedReputation?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  posts               Post[]
  comments            Comment[]
  votes               Vote[]
  quotes              Quote[]
  messages            Message[]      @relation("Messages")
  directMessages      DirectMessage[] @relation("DirectMessages")
  notifications       Notification[]  @relation("NotificationRecipient")
  notificationsFrom   Notification[]  @relation("NotificationSender")
  activities          Activity[]
  reactions           Reaction[]
  reputations         UserReputation?
  rosters             Roster[]        @relation("RosterUser")
  buddyRosters        Roster[]        @relation("RosterBuddy")
  buddyRequestsSent     BuddyRelationship[] @relation("BuddyRequester")
  buddyRequestsReceived BuddyRelationship[] @relation("BuddyRecipient")
  blocksMade            UserBlock[]         @relation("UserBlocker")
  blocksReceived        UserBlock[]         @relation("UserBlocked")
  presence            Presence?
  typingIndicators    Typing[]
  inviteSent          UserInvite[]    @relation("InviteSender")
  userReportsMade     UserReport[]    @relation("Reporter")
  userReportsReceived UserReport[]    @relation("ReportedUser")
  botReportsMade      BotReport[]     @relation("BotReporter")
  botReportsReceived  BotReport[]     @relation("BotReportedUser")
  createdTags         Tag[]           @relation("TagCreator")
  memberOfTags        String[]        @map("memberOfGroups") @db.ObjectId
  voteLog             VoteLog[]
  collections         Collection[]
  termsAcceptances    TermsAcceptance[]

  @@index([accountStatus])
  @@index([botReports, lastBotReportDate])
  @@map("users")
}

// Append-only Terms of Service acceptance records (issue #573).
// No mutable boolean on User — absence of a row means never accepted.
model TermsAcceptance {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                 @db.ObjectId
  termsVersion String
  termsHash    String
  acceptedAt   DateTime               @default(now())
  source       TermsAcceptanceSource
  createdAt    DateTime               @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, termsVersion])
  @@index([userId])
  @@map("terms_acceptances")
}
